{
  "name": "radio-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Radio recorder monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "install:frontend": "npm install --workspace=apps/frontend",
    "install:backend": "cd apps/backend && pip install -r requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}