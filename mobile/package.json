{
  "name": "radio-recorder-mobile",
  "version": "1.0.0",
  "description": "Radio Recorder Mobile App built with Capacitor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "web": "npm run dev",
    "sync": "npx cap sync",
    "sync:ios": "npx cap sync ios",
    "sync:android": "npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios",
    "build:android": "npm run build && npx cap sync android",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "@tanstack/react-router": "^1.58.3",
    "@tanstack/react-query": "^5.17.0",
    "zustand": "^4.4.7",
    "axios": "^1.6.2",
    "recharts": "^2.9.0",
    "wavesurfer.js": "^7.6.0",
    "tailwindcss": "^3.3.6",
    "@capacitor/core": "^5.6.0",
    "@capacitor/android": "^5.6.0",
    "@capacitor/ios": "^5.6.0",
    "@capacitor/camera": "^5.6.0",
    "@capacitor/filesystem": "^5.6.0",
    "@capacitor/geolocation": "^5.6.0",
    "@capacitor/local-notifications": "^5.6.0",
    "@capacitor/device": "^5.6.0",
    "@capacitor/app": "^5.6.0",
    "@capacitor/network": "^5.6.0",
    "@capacitor/keyboard": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.30",
    "tailwindcss": "^3.3.6",
    "@capacitor/cli": "^5.6.0"
  }
}
